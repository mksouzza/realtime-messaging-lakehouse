# Google Cloud Platform (GCP) Configuration
GCP_PROJECT_ID=messaging-analytics-prod
GCP_REGION=us-central1
GCP_CREDENTIALS_PATH=./secrets/gcp-sa-key.json

# Storage & Lakehouse Buckets
GCS_LAKEHOUSE_BUCKET=lakehouse-prod-us-central1
GCS_BRONZE_PREFIX=lakehouse/bronze
GCS_SILVER_PREFIX=lakehouse/silver
GCS_GOLD_PREFIX=lakehouse/gold

# BigQuery Datasets
BQ_DATASET_ANALYTICS=messaging_analytics
BQ_DATASET_GOVERNANCE=messaging_governance

# Streaming / PubSub / Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MESSAGING_EVENTS=omnichannel.events.v1
PUBSUB_TOPIC_ID=omnichannel-messaging-events

# Local MinIO Emulation (Optional Local Lakehouse Mode)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000
